# ── Delicate Engine · environment ─────────────────────────────────────────────
# Copy to .env for local dev. Every service reads the same file (docker compose too).

NODE_ENV=development
LOG_LEVEL=debug

# Postgres. Local dev: the compose `postgres` service. Prod: Supabase pooler URL.
DATABASE_URL=postgres://delicate:delicate@localhost:5433/delicate
# Separate DB for integration tests (created by compose as well)
TEST_DATABASE_URL=postgres://delicate:delicate@localhost:5433/delicate_test

# Supabase Auth. The API verifies Supabase-issued JWTs.
#  - Legacy projects: set SUPABASE_JWT_SECRET (HS256).
#  - New projects: leave secret empty; the API fetches JWKS from SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Local dev without a Supabase project: mint dev tokens with `pnpm --filter @delicate/api run dev:token`
AUTH_DEV_SECRET=dev-only-change-me-32-chars-minimum!!

# API
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Web (Next.js). The browser reaches the engine through the same-origin /api proxy;
# API_INTERNAL_URL is where the Next server finds the engine (Docker: http://api:8080).
API_INTERNAL_URL=http://localhost:8080
# Only set NEXT_PUBLIC_API_URL to point the browser at a separately hosted engine.
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
