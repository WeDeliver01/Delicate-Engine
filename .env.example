# ── Delicate Engine · environment ─────────────────────────────────────────────
# Copy to .env for local dev. Every service reads the same file (docker compose too).

NODE_ENV=development
LOG_LEVEL=debug

# Postgres. Local dev: the compose `postgres` service. Prod: Supabase pooler URL.
DATABASE_URL=postgres://delicate:delicate@localhost:5433/delicate
# Separate DB for integration tests (created by compose as well)
TEST_DATABASE_URL=postgres://delicate:delicate@localhost:5433/delicate_test

# Supabase Auth. The API verifies Supabase-issued JWTs.
#  - Legacy projects: set SUPABASE_JWT_SECRET (HS256).
#  - New projects: leave secret empty; the API fetches JWKS from SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Local dev without a Supabase project: mint dev tokens with `pnpm --filter @delicate/api run dev:token`
AUTH_DEV_SECRET=dev-only-change-me-32-chars-minimum!!

# Google Maps Platform (Places API New + Routes API). Leave unset to use the free fallback
# (OpenStreetMap geocoding + straight-line x road factor) — fine for development.
# GOOGLE_MAPS_API_KEY=

# Payments — manual EFT details shown to customers (provider disabled until set)
EFT_ACCOUNT_NAME=Delicate Courier
EFT_BANK_NAME=
EFT_ACCOUNT_NUMBER=
EFT_BRANCH_CODE=
# PayFast (all three required to enable). Use sandbox credentials + PAYFAST_SANDBOX=1 to test.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=1

# API
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Web (Next.js). The browser reaches the engine through the same-origin /api proxy;
# API_INTERNAL_URL is where the Next server finds the engine (Docker: http://api:8080).
API_INTERNAL_URL=http://localhost:8080
# Only set NEXT_PUBLIC_API_URL to point the browser at a separately hosted engine.
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Notifications — SMS and WhatsApp via Twilio.
# Leave blank and those messages are still recorded in the console, marked suppressed with the
# reason, and never sent. Email needs SMTP_* above; these two channels need Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +27600000000
TWILIO_SMS_FROM=
# E.164 of the approved WhatsApp sender, WITHOUT the "whatsapp:" prefix
TWILIO_WHATSAPP_FROM=
# Optional: a Messaging Service (MG...) used instead of the two numbers above.
TWILIO_MESSAGING_SERVICE_SID=
