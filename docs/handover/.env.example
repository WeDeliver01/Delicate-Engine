# ── Delicate Courier portal · environment template ──
# Copy the values you need into Replit Secrets. Everything is optional: with
# nothing set the system runs on SQLite with all integrations inert (no external
# calls), which is the right state for a first boot.

# Core Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-repl.replit.app
DJANGO_TIME_ZONE=Africa/Johannesburg

# Database (leave unset for SQLite; set for Postgres in production)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Supabase auth (shared identity provider with the API platform)
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_AUD=authenticated

# ShipLogic (live rates, shipment creation, tracking webhook)
SHIPLOGIC_API_URL=https://api.shiplogic.com
SHIPLOGIC_TOKEN=
SHIPLOGIC_PROVIDER_ID=
SHIPLOGIC_CATCHALL_SERVICE_LEVEL_CODE=SPX
SHIPLOGIC_WEBHOOK_SECRET=

# Cross-system federation (signed channels to the .NET platform / route planner)
DAA_SYNC_SECRET=

# Loyalty / money Event Engine (system of record over the outbox)
ENGINE_INGEST_URL=
ENGINE_INGEST_HMAC=

# Payments provider for prepaid top-ups (stub keeps it inert)
PAYMENTS_PROVIDER=stub

# Pricing / liability
LIABILITY_RATE_PERCENT=2.5

# Treasury allocation engine (operational cost inputs, not hardcoded allocation %)
TREASURY_FUEL_PCT=0.14
TREASURY_DRIVER_PCT=0.32
TREASURY_URGENCY_WINDOW_DAYS=10
TREASURY_URGENCY_BOOST=1.5
