{
  "name": "@delicate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.js\"",
    "dev:worker": "node --watch --enable-source-maps --env-file-if-exists=../../.env dist/worker.js",
    "dev:token": "tsx --env-file-if-exists=../../.env src/scripts/dev-token.ts",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@delicate/contracts": "workspace:*",
    "@delicate/db": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "drizzle-orm": "catalog:",
    "express": "^5.1.0",
    "jose": "catalog:",
    "nestjs-pino": "^4.4.0",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@delicate/config": "workspace:*",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "pino-pretty": "catalog:",
    "supertest": "^7.1.4",
    "tsx": "catalog:",
    "unplugin-swc": "^1.5.5",
    "vitest": "catalog:"
  }
}
