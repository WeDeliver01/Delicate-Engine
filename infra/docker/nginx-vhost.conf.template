# Vhost template for one Delicate host.
#
# Rendered by infra/scripts/nginx-vhost.sh; the __PLACEHOLDERS__ below are not valid nginx, so
# this file is never installed as it stands. Everything above the sentinel line is these notes
# and is dropped on the way out.
#
# One template rather than a file per host. A second hostname used to mean copying the whole
# thing and changing one word, which is how two vhosts end up with different timeouts and
# nobody knows which is right.
#
# Placeholders: __HOST__, __SLUG__ (session-cache zone name), __WEB_PORT__, __API_PORT__,
# __ROBOTS__ (the indexing header, or a note saying indexing is deliberate).
#
# ---8<--- rendered output begins below this line
# ── HTTP: renewals, and a push to HTTPS for everything else ──────────────────
server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;

    # Let's Encrypt writes its challenge file into the webroot and fetches it over plain HTTP.
    # Without this it would be proxied to the web app like everything else, which answers 404.
    # This is needed at every renewal, not just the first issue. "^~" beats the catch-all.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
        access_log off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ────────────────────────────────────────────────────────────────────
server {
    # nginx 1.24 on this box: http2 goes on the listen line. The separate `http2 on;` directive
    # only exists from 1.25.1, and using it here fails the config test.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __HOST__;

    ssl_certificate     /etc/letsencrypt/live/__HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HOST__/privkey.pem;

    # Set inline rather than including certbot's options-ssl-nginx.conf, which is installed by
    # the nginx plugin — not present on this box, and a missing include fails the config test
    # for every site, not just this one.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    # The cache name must be unique per host, or nginx refuses to start with a duplicate zone.
    ssl_session_cache shared:SSL___SLUG__:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Proof-of-delivery photos arrive as data URLs inside JSON.
    client_max_body_size 4m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
__ROBOTS__
    # The engine. Straight through, so a webhook signature is computed over the bytes the
    # provider actually sent — anything that re-encodes the body breaks it.
    location /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 60s;
    }

    # The web app: marketing, the customer portal and the ops console, one Next.js app.
    location / {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}
