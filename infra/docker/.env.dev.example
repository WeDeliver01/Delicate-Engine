# dev.delicatecourier.co.za — copy to .env beside compose.dev-host.yml and fill in.
#
# This file is read by both docker compose (for the hostname and database password) and the API
# container (everything else). Keep it out of git; it holds credentials.

# ── this host ────────────────────────────────────────────────────────────────
DEV_HOST=dev.delicatecourier.co.za
APP_VERSION=dev

# This VPS already serves other sites, so the stack binds to loopback and the web server that
# already owns ports 80/443 proxies to it. Change these only if something else uses them.
WEB_BIND_PORT=8090
API_BIND_PORT=8091

# ── database (runs in a container on this host) ──────────────────────────────
# This is NOT a Supabase database URL. The engine's own Postgres runs beside it in a container,
# and "postgres" below is that container's name, not a host on the internet. SUPABASE_URL further
# down is a separate thing entirely: it is only used to check who is signing in.
#
# Supabase Postgres does work, but only via its *session pooler* string — the direct
# db.<ref>.supabase.co address resolves to IPv6 only, which a Docker container cannot reach.
# If you go that way, also stop the postgres service so you are not running one for nothing.
POSTGRES_USER=delicate
POSTGRES_DB=delicate
# Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=
# Must match the three above. The host is the compose service name.
DATABASE_URL=postgres://delicate:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/delicate

# ── where the engine thinks it lives ─────────────────────────────────────────
API_PUBLIC_URL=https://dev.delicatecourier.co.za/api
WEB_PUBLIC_URL=https://dev.delicatecourier.co.za
CORS_ORIGINS=https://dev.delicatecourier.co.za

# ── auth (who may sign in — NOT where data is stored) ────────────────────────
# Required. The runtime image is a production build and refuses development tokens: a public
# host with dev tokens would be a real hole, and the login your customers will use is the one
# worth testing. A free Supabase project is enough for a dev environment.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# These two are compiled into the browser bundle at image build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── optional: everything below can be left blank ─────────────────────────────
# Without a Maps key, quotes price on straight-line distance with a road factor.
# Addresses and road distance: Geoapify primary, LocationIQ fallback.
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=

# Outbound email. Without it, messages are recorded and held rather than sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Card top-ups. Use sandbox credentials on a dev host.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=1
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# Bank details shown for EFT top-ups are set in the console under Settings, not here.
