# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── This service's own database (separate from the Route Optimizer) ─────────
DATABASE_URL=postgres://user:pass@host:5432/delicate_event_engine

# ── Auth ────────────────────────────────────────────────────────────────────
# Issues and verifies customer-portal tokens for this service.
CUSTOMER_JWT_SECRET=change-me-long-random-string

# MUST equal the Route Optimizer's SESSION_SECRET so driver-app JWTs validate
# here without the driver having to log in again.
ROUTE_OPTIMIZER_SESSION_SECRET=copy-from-route-optimizer

# Protects all /admin/* and /ops/* endpoints. Send as: x-admin-key: <value>
ADMIN_API_KEY=change-me-admin-key

# ── Inbound webhook from the Route Optimizer ────────────────────────────────
# The Route Optimizer signs its completion webhooks with this shared secret
# (HMAC-SHA256). The patch in integrations/route-optimizer-patch uses the same.
ROUTE_OPTIMIZER_WEBHOOK_SECRET=change-me-shared-with-route-optimizer

# Reject webhooks whose timestamp is older than this (seconds). Replay guard.
WEBHOOK_MAX_SKEW_SECONDS=300

# ── NTAG 424 DNA (SUN / SDM) ────────────────────────────────────────────────
# App-wide AES-128 keys, hex (32 chars each). These live ONLY here and inside
# the tags' secure memory. They are never sent to a phone and the tag will not
# reveal them, so the same key on every tag is safe: clone protection comes
# from the unextractable key plus the monotonic tap counter.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
NTAG_META_READ_KEY=00000000000000000000000000000000
NTAG_FILE_READ_KEY=00000000000000000000000000000000

# URL param names your tags are encoded to mirror into. Defaults match the
# common "encrypted PICC + CMAC" layout. Adjust if your encoder differs.
NTAG_PICC_PARAM=picc_data
NTAG_CMAC_PARAM=cmac
NTAG_ENC_PARAM=enc
