{
  "name": "delicate-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build --concurrency=1",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck --concurrency=1",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @delicate/db run generate",
    "db:migrate": "pnpm --filter @delicate/db run migrate",
    "db:seed": "pnpm --filter @delicate/db run seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.2"
  }
}
